[Unit]
Description=Fracture Recovery web client
After=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/fracture-recovery
ExecStart=/usr/bin/python3 -m http.server 3101 --bind 0.0.0.0 --directory /opt/fracture-recovery/dist
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
